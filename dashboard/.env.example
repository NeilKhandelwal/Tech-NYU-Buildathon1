NEXT_PUBLIC_API_URL=http://localhost:8000

# Signing key for the staff session cookie. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=

# Staff accounts, "name:hash" comma-separated. Generate a hash with
# `npm run hash-password -- <password>`. The sample below is the password "demo".
# DEV ONLY: leave STAFF_USERS empty and dashboard auth is DISABLED — every route is open
# and Nav shows nobody, so a fresh clone runs without setting anything up. Never ship a
# deployment with it empty.
STAFF_USERS=demo:scrypt$79ccfa1394f3ace728444e88ceb3b129$01a38426ab70cbf5343fafc3744a49cbe2111def2bf410f677dcaab96b92d2cc
