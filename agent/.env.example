# ELEVENLABS_API_KEY is read from backend/.env; set it here only to use a different key
# empty on the first run: provision.py creates each agent and prints its id; fill them in so
# later runs update the same agents instead of creating new ones
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_CALLBACK_AGENT_ID=
# where ElevenLabs reaches the backend's /api/tools/*
PUBLIC_BACKEND_URL=https://heatcheck-nyu.fly.dev
# optional; the same value as HC_TOOL_SECRET on Fly, sent as X-Tool-Secret on every tool call
HC_TOOL_SECRET=
