# ELEVENLABS_API_KEY is read from backend/.env; set it here only to use a different key
# empty on the first run: provision.py creates each agent and prints its id; fill them in so
# later runs update the same agents instead of creating new ones
ELEVENLABS_AGENT_ID=
ELEVENLABS_CALLER_AGENT_ID=
ELEVENLABS_TENANT_AGENT_ID=
ELEVENLABS_LANDLORD_AGENT_ID=
# where ElevenLabs reaches the backend's /voice/tools/* (a tunnel locally, the deploy URL otherwise)
PUBLIC_BACKEND_URL=https://your-tunnel.trycloudflare.com
# the same value as backend/.env; ElevenLabs sends it as X-Voice-Secret on every tool call
VOICE_TOOL_SECRET=
