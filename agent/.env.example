ELEVENLABS_API_KEY=
# empty on the first run: provision.py creates the agent and prints its id
ELEVENLABS_AGENT_ID=
# where ElevenLabs reaches the backend's /voice/tools/* (a tunnel locally, the deploy URL otherwise)
PUBLIC_BACKEND_URL=https://your-tunnel.trycloudflare.com
# the same value as backend/.env; ElevenLabs sends it as X-Voice-Secret on every tool call
VOICE_TOOL_SECRET=
