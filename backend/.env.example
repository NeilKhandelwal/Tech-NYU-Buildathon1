# ElevenLabs (CONTRACT "## ElevenLabs voice" and "## Tenant advocate"). The agent ids come from
# `cd agent && uv run python provision.py`. The key needs ElevenLabs Agents read + write.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=              # intake: the browser /call page and inbound calls
ELEVENLABS_CALLER_AGENT_ID=       # calls the landlord
ELEVENLABS_TENANT_AGENT_ID=       # calls the tenant: heat checks and report-back
# the imported Twilio number outbound calls come from (ElevenLabs -> Phone Numbers)
ELEVENLABS_PHONE_NUMBER_ID=
# how long ask_tenant waits for the tenant's answer; keep it under provision.py's 120 s webhook timeout
# ASK_TENANT_TIMEOUT_S=90
# live subtitles in the tenant's language; unset = no translation
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   # live-verified Aug 2026; set this if Google retires it
# shared with agent/.env; every /voice/tools/* request must carry it as X-Voice-Secret.
# make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
VOICE_TOOL_SECRET=
# the post-call webhook's HMAC secret, shown once when you create the webhook in ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
# Twilio SMS (CONTRACT "## SMS"). Unset = every text is logged as not_sent and shown on the
# dashboard's SMS panel instead. Console -> Account Info has the SID and token; a trial account
# only texts numbers verified under Phone Numbers -> Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=              # E.164, e.g. +15551234567
# the public URL Twilio reaches this backend at (your tunnel); the inbound webhook is
# PUBLIC_BACKEND_URL + /sms/webhooks/twilio, and its signature is checked against exactly that
PUBLIC_BACKEND_URL=
CORS_ORIGINS=http://localhost:3000
# Database. Unset means a SQLite file at backend/cases.db (no infrastructure needed).
# Compose and CI use Postgres: DATABASE_URL=postgresql+psycopg://cases:cases@localhost:5432/cases
# DATABASE_URL=
# The city this deployment serves. Unset means 1, the city the first migration seeds.
# CITY_ID=1
